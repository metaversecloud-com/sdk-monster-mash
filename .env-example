INSTANCE_DOMAIN=api.topia.io
INTERACTIVE_KEY=your_interactive_key
INTERACTIVE_SECRET=your_interactive_secret
NODE_ENV="development"

# Where the client + server fetch part PNGs from. Local dev serves
# `client/public/parts/` via Vite so this can stay empty; production
# should point at an S3 bucket (e.g. https://topia-dev-test.s3.amazonaws.com/sdk-monster-mash/parts).
PARTS_BASE_URL=https://us-east-1.console.aws.amazon.com/s3/buckets/sdk-monster-mash

# S3 bucket for composed monster PNGs. Local dev uses `topia-dev-test`.
S3_BUCKET=sdk-monster-mash
